<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:padding="12dp">

        <TextView android:id="@+id/tvItemClienteNombre" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Nombre del Cliente" android:textColor="#212121" android:textSize="16sp" android:textStyle="bold"/>

        <LinearLayout android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="match_parent" android:orientation="horizontal">

            <TextView android:id="@+id/tvItemClienteDni" android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="DNI: 00000000" android:textColor="#757575" android:textSize="13sp"/>

            <TextView android:id="@+id/tvItemClienteTelefono" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="Teléfono: 999999999" android:textColor="#757575" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
